{
  "name": "collider-agent-js",
  "version": "0.2.0-rc1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/export-doctrine-seeds.mjs",
    "prestart": "npm run build",
    "start": "node dist/cli/main.js",
    "prestart:fuji": "npm run build",
    "start:fuji": "node dist/cli/main.js --fuji-easy-start",
    "prestart:fuji:disposable": "npm run build",
    "start:fuji:disposable": "node dist/cli/main.js --fuji-easy-start --create-disposable-test-wallet",
    "prestart:fuji:gap": "npm run build",
    "start:fuji:gap": "node dist/cli/main.js --fuji-gap-easy-start",
    "prestart:fuji:native-v2": "npm run build",
    "start:fuji:native-v2": "node dist/cli/main.js --fuji-native-v2",
    "prestart:fuji:bonded": "npm run build",
    "start:fuji:bonded": "node dist/cli/main.js --fuji-bonded",
    "prepare:fuji:public": "node dist/cli/prepare-public-rc1.js",
    "prestart:fuji:public": "npm run build",
    "start:fuji:public": "node dist/cli/main.js --fuji-public-rc1",
    "cancel:fuji:public": "node dist/cli/cancel-public-withdrawal.js",
    "preforecast:publisher": "npm run build",
    "forecast:publisher": "node dist/cli/publish-forecasts.js",
    "prestart:fuji:gap:disposable": "npm run build",
    "start:fuji:gap:disposable": "node dist/cli/main.js --fuji-gap-easy-start --create-disposable-test-wallet",
    "wallet:fuji:create": "node dist/cli/create-fuji-test-wallet.js",
    "dev": "tsx src/cli/main.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "start:once": "node dist/cli/main.js --once --no-monitor",
    "start:headless": "node dist/cli/main.js --loop --no-monitor",
    "start:monitor": "node dist/cli/monitor.js",
    "soak:supervisor": "node dist/cli/soak-supervisor.js",
    "withdraw": "node dist/cli/withdraw.js",
    "dev:once": "tsx src/cli/main.ts --once --no-monitor",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "prestart:rc1": "npm run build",
    "start:rc1": "node dist/cli/rc1-start.js",
    "package:rc1": "node scripts/package-rc1.mjs",
    "verify:rc1": "node scripts/verify-rc1-source.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
